{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scilene",
  "version": "0.5.0",
  "identifier": "me.yasirmo.scilene",
  "build": {
    "devUrl": "http://127.0.0.1:8000",
    "frontendDist": null
  },
  "app": {
    "windows": [
      {
        "title": "Scilene",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/scilene-server"
    ]
  }
}
